# auto | bedrock | openai | ollama | none   (none = deterministic mode, no LLM)
SAANSSAFE_PROVIDER=auto
# Bedrock (used automatically if AWS credentials are present)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# OpenAI-compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Ollama
OLLAMA_HOST=
OLLAMA_MODEL=llama3.1
